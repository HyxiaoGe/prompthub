# Database
DATABASE_URL=postgresql+asyncpg://prompthub:prompthub_dev@localhost:5432/prompthub
DATABASE_URL_SYNC=postgresql://prompthub:prompthub_dev@localhost:5432/prompthub

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_NAME=PromptHub
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
PROMPTHUB_SEED_ADMIN_API_KEY=

# 服务令牌配置（backend/scripts/provision_service_token.py）
PROMPTHUB_SERVICE_TOKEN_PROJECT_SLUG=
PROMPTHUB_SERVICE_TOKEN_NAME=
# 明文服务令牌必须使用 phs_ 前缀
PROMPTHUB_SERVICE_TOKEN=
PROMPTHUB_SERVICE_TOKEN_SCOPE=prompts:read

# API
API_PREFIX=/api/v1
API_DEFAULT_PAGE_SIZE=20

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# LLM (Phase 5)
LLM_DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# OPENAI_BASE_URL=  # Optional: Gemini OpenAI-compatible endpoint
